# uv run 会加载本文件；把仓库根目录加入 PYTHONPATH，子目录脚本才能 import config
PYTHONPATH=.


# ============================================================
# 大模型配置（多模型支持，想用哪个就配哪个）
# 代码中通过 settings.get_llm_kwargs("deepseek") 切换
# ============================================================

# ===== DeepSeek（默认，推荐练习用） =====
# DeepSeek OpenAI兼容接口，便宜好用
DEEPSEEK_API_KEY=sk-你的deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TEMPERATURE=0.3

# ===== OpenAI（可选，有key再配） =====
# OPENAI_API_KEY=sk-你的openai-api-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.3

# ===== 通义千问 Qwen（代码审查用，必配） =====
# 阿里云DashScope，OpenAI兼容接口
QWEN_API_KEY=sk-你的qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_TEMPERATURE=0.3

# ============================================================
# MySQL配置（Text-SQL用，可选）
# ============================================================
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your-password
# MYSQL_DATABASE=your_db
